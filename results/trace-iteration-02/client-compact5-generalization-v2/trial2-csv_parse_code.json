    "text": "# Reading CSV, Validating Scores, and Finding Top 3\n\nHere's a complete solution using only the standard library:\n\n```python\nimport csv\nimport io\nfrom typing import Iterable\n\n\ndef top_three(csv_text: str) -> list[str]:\n    \"\"\"\n    Parse CSV text with 'name' and 'score' columns.\n\n    - Rows with an empty score are skipped.\n    - Rows with a non-empty but invalid score raise ValueError,\n      including the 1-based row number (counting the header as row 1).\n    - Returns the names of the three highest scorers.\n    - Ties are broken alphabetically (ascending name).\n    \"\"\"\n    reader = csv.reader(io.StringIO(csv_text))\n\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    # Locate the columns by name (case-insensitive, whitespace-trimmed).\n    try:\n        name_idx = header.index(\"name\")\n        score_idx = header.index(\"score\")\n    except ValueError as exc:\n        raise ValueError(f\"CSV must have 'name' and 'score' columns: {header}\") from exc\n\n    scored: list[tuple[float, str]] = []\n\n    # Row numbers: header is row 1, first data row is row 2.\n    for row_num, row in enumerate(reader, start=2):\n        # Skip completely blank lines.\n        if not row or all(cell.strip() == \"\" for cell in row):\n            continue\n\n        # Guard",
